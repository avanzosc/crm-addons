<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <record id="view_crm_claim_pivot" model="ir.ui.view">
    <field name="name">crm.claim.pivot</field>
    <field name="model">crm.claim</field>
    <field name="arch" type="xml">
      <pivot string="Claims" disable_linking="True" display_quantity="true">
        <field name="stage_id" type="row" />
        <field name="create_date" type="col" interval="month" />
      </pivot>
    </field>
  </record>

  <record id="view_crm_case_claims_filter" model="ir.ui.view">
    <field name="model">crm.claim</field>
    <field name="inherit_id" ref="crm_claim.view_crm_case_claims_filter" />
    <field name="arch" type="xml">
      <xpath expr="//field[@name='user_id']" position="after">
        <field name="team_id" />
        <field name="stage_id" />
        <field name="categ_id" string="Category" />
        <field name="type_action" />
        <field name="priority" />
        <field name="company_id" groups="base.group_multi_company" />
        <field name="date" />
        <field name="date_deadline" />
        <field name="date_closed" />
        <field name="create_date" />
        <field name="write_date" />
      </xpath>

      <xpath expr="//filter[@name='Unassigned Claims']" position="after">
        <filter
          string="Open"
          name="open_claims"
          domain="[('date_closed', '=', False)]"
        />
        <filter
          string="Closed"
          name="closed_claims"
          domain="[('date_closed', '!=', False)]"
        />
        <filter
          string="Overdue"
          name="overdue_claims"
          domain="[('date_deadline', '&lt;', context_today()), ('date_closed', '=', False)]"
        />
        <filter
          string="Deadline Today"
          name="deadline_today"
          domain="[('date_deadline', '=', context_today())]"
        />
        <filter string="Archived" name="archived" domain="[('active', '=', False)]" />
      </xpath>

      <filter name="type" position="attributes">
        <attribute name="string">Category</attribute>
      </filter>
      <filter name="claim_month" position="attributes">
        <attribute name="string">Claim Date</attribute>
      </filter>
      <filter name="deadline" position="attributes">
        <attribute name="string">Deadline Date</attribute>
      </filter>
      <filter name="closure" position="attributes">
        <attribute name="string">Closure Date</attribute>
        <attribute name="groups" />
      </filter>
      <filter name="closure" position="after">
        <filter
          string="Creation Date"
          name="group_create_date"
          context="{'group_by': 'create_date'}"
        />
        <filter
          string="Updated Date"
          name="group_write_date"
          context="{'group_by': 'write_date'}"
        />
        <separator />
        <filter string="Claim" name="group_name" context="{'group_by': 'name'}" />
        <filter
          string="Sales Team"
          name="group_team"
          context="{'group_by': 'team_id'}"
        />
        <filter
          string="Action Type"
          name="group_type_action"
          context="{'group_by': 'type_action'}"
        />
        <filter
          string="Priority"
          name="group_priority"
          context="{'group_by': 'priority'}"
        />
        <filter
          string="Company"
          name="group_company"
          context="{'group_by': 'company_id'}"
          groups="base.group_multi_company"
        />
      </filter>
    </field>
  </record>

  <record id="crm_claim.crm_claim_category_claim0" model="ir.actions.act_window">
    <field name="view_mode">list,calendar,form,pivot</field>
  </record>

  <record id="action_crm_claim_pivot_view" model="ir.actions.act_window.view">
    <field name="sequence" eval="4" />
    <field name="view_mode">pivot</field>
    <field name="view_id" ref="view_crm_claim_pivot" />
    <field name="act_window_id" ref="crm_claim.crm_claim_category_claim0" />
  </record>
</odoo>
