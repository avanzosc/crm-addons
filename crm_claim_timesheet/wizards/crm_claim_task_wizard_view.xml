<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="crm_claim_task_wizard_form" model="ir.ui.view">
        <field name="name">crm.claim.task.wizard.form</field>
        <field name="model">crm.claim.task.wizard</field>
        <field name="arch" type="xml">
            <form string="Change Task">
                <sheet>
                    <group>
                        <field name="claim_id" invisible="1" />
                        <field name="project_id" />
                        <field name="current_task_id" string="Current Task" />
                        <field
              name="new_task_id"
              domain="[('project_id', '=', project_id)]"
              options="{'no_create_edit': True}"
            />
                    </group>
                    <p>
                        This claim has timesheet entries linked to the current task.
                        Do you want to reassign them to the new task?
                    </p>
                </sheet>
                <footer>
                    <button
            name="action_update_timesheets"
            string="Yes, update timesheets"
            type="object"
            class="btn-primary"
          />
                    <button
            name="action_no_update"
            string="No, keep timesheets as-is"
            type="object"
          />
                </footer>
            </form>
        </field>
    </record>
</odoo>
