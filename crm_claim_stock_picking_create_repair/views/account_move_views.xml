<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
  <record model="ir.ui.view" id="view_invoice_tree">
    <field name="model">account.move</field>
    <field name="inherit_id" ref="account.view_invoice_tree" />
    <field name="arch" type="xml">
      <field name="invoice_origin" position="after">
        <field name="crm_claim_id" optional="show" />
      </field>
    </field>
  </record>

  <record model="ir.ui.view" id="view_move_form">
    <field name="model">account.move</field>
    <field name="inherit_id" ref="account.view_move_form" />
    <field name="arch" type="xml">
      <field name="invoice_vendor_bill_id" position="after">
        <field name="crm_claim_id" readonly="1" />
      </field>
    </field>
  </record>

  <record model="ir.ui.view" id="view_account_invoice_filter">
    <field name="model">account.move</field>
    <field name="inherit_id" ref="account.view_account_invoice_filter" />
    <field name="arch" type="xml">
      <field name="partner_id" position="after">
        <field name="crm_claim_id" />
      </field>
      <filter name="group_by_company" position="before">
        <filter
          string="Claim"
          name="group-crm-claim"
          context="{'group_by': 'crm_claim_id'}"
        />
      </filter>
    </field>
  </record>
</odoo>
